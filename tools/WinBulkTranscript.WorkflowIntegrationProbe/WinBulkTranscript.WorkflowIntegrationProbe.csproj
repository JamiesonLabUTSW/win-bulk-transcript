<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>WinBulkTranscript.WorkflowIntegrationProbe</RootNamespace>
    <AssemblyName>WinBulkTranscript.WorkflowIntegrationProbe</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Disposable runtime evidence code; keep it outside the release solution and restore it explicitly. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The probe composes the same production media and Foundry adapters as the WinUI app. -->
    <ProjectReference Include="..\..\src\WinBulkTranscript.App\WinBulkTranscript.App.csproj" />
  </ItemGroup>
</Project>
