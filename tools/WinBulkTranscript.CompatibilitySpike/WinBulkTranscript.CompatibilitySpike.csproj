<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishSelfContained>true</PublishSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Disposable Phase 0 evidence code is restored explicitly, outside the release solution. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\WinBulkTranscript.Core\WinBulkTranscript.Core.csproj" />
    <PackageReference Include="Microsoft.AI.Foundry.Local" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <Compile Include="..\..\src\WinBulkTranscript.App\Foundry\FoundryModelContract.cs" Link="Foundry\FoundryModelContract.cs" />
  </ItemGroup>
</Project>
