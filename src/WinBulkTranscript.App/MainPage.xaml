<Page
    x:Class="WinBulkTranscript.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto">
        <Grid
            HorizontalAlignment="Center"
            MaxWidth="1000"
            MinWidth="600"
            Padding="24"
            RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Bulk Transcript" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Create WebVTT transcripts for every MP4 in a folder. Files are processed one at a time."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Folders" />

                    <Grid ColumnSpacing="12" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Input folder" />
                        <TextBox
                            x:Name="InputFolderTextBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            MinWidth="260"
                            AutomationProperties.HelpText="Choose the folder that contains MP4 files to transcribe."
                            AutomationProperties.Name="Input folder"
                            IsReadOnly="True"
                            Text="{Binding InputFolderPath, Mode=OneWay}"
                            TextWrapping="NoWrap"
                            ToolTipService.ToolTip="{Binding InputFolderPath}" />
                        <Button
                            x:Name="BrowseInputButton"
                            Grid.Row="0"
                            Grid.Column="2"
                            MinWidth="96"
                            AccessKey="I"
                            AutomationProperties.Name="Browse for input folder"
                            Click="BrowseInputButton_Click"
                            Content="Browse"
                            IsEnabled="{Binding IsFolderSelectionEnabled}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                            Text="{Binding InputValidationMessage}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Output folder" />
                        <TextBox
                            x:Name="OutputFolderTextBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            MinWidth="260"
                            AutomationProperties.HelpText="Choose where matching WebVTT files will be written."
                            AutomationProperties.Name="Output folder"
                            IsReadOnly="True"
                            Text="{Binding OutputFolderPath, Mode=OneWay}"
                            TextWrapping="NoWrap"
                            ToolTipService.ToolTip="{Binding OutputFolderPath}" />
                        <Button
                            x:Name="BrowseOutputButton"
                            Grid.Row="2"
                            Grid.Column="2"
                            MinWidth="96"
                            AccessKey="O"
                            AutomationProperties.Name="Browse for output folder"
                            Click="BrowseOutputButton_Click"
                            Content="Browse"
                            IsEnabled="{Binding IsFolderSelectionEnabled}" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                            Text="{Binding OutputValidationMessage}"
                            TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding FoundMp4Text}" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            x:Name="StartButton"
                            MinWidth="164"
                            AccessKey="S"
                            AutomationProperties.Name="Start transcription"
                            Command="{Binding StartCommand}"
                            Content="Start transcription"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="CancelButton"
                            MinWidth="120"
                            AccessKey="C"
                            AutomationProperties.Name="{Binding CancelButtonAccessibleName}"
                            Command="{Binding CancelCommand}"
                            Content="{Binding CancelButtonText}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Spacing="12">
                <controls:InfoBar
                    AutomationProperties.HelpText="{Binding InfoBarMessage}"
                    AutomationProperties.LiveSetting="Assertive"
                    AutomationProperties.Name="{Binding InfoBarTitle}"
                    IsOpen="{Binding IsInfoBarOpen, Mode=TwoWay}"
                    IsClosable="True"
                    Message="{Binding InfoBarMessage}"
                    Severity="{Binding InfoBarSeverity}"
                    Title="{Binding InfoBarTitle}" />

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{Binding CurrentFileName}" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Text="{Binding CurrentStageText}"
                            TextWrapping="Wrap" />
                        <ProgressBar
                            AutomationProperties.Name="Current file progress"
                            IsIndeterminate="{Binding IsProgressIndeterminate}"
                            Maximum="100"
                            Value="{Binding CurrentFileProgressPercent}" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Text="{Binding BatchCountText}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="3" MinHeight="180" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Files" />
                <ListView
                    Grid.Row="1"
                    AutomationProperties.Name="Transcription files"
                    IsItemClickEnabled="False"
                    ItemsSource="{Binding Jobs}"
                    MaxHeight="480"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding StatusText}"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="16"
                                    Text="{Binding StatusGlyph}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        AutomationProperties.Name="{Binding AccessibleDescription}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{Binding FileName}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{Binding RelativePath}" />
                                    <TextBlock
                                        AutomationProperties.Name="{Binding RelativePath}"
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                        Text="{Binding RelativePath}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTipService.ToolTip="{Binding RelativePath}" />
                                    <TextBlock
                                        Text="{Binding StatusText}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                        Text="{Binding Detail}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTipService.ToolTip="{Binding Detail}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
