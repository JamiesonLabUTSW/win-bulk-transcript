<Page
    x:Class="WinBulkTranscript.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid Padding="28,20,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Bulk Transcript" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Turn a folder of MP4 files into WebVTT transcripts." />
            </StackPanel>

            <CommandBar
                Grid.Column="1"
                HorizontalAlignment="Right"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True">
                <AppBarButton
                    x:Name="StartButton"
                    AccessKey="S"
                    AutomationProperties.Name="Start transcription"
                    Command="{Binding StartCommand}"
                    Icon="Play"
                    Label="Start" />
                <AppBarButton
                    x:Name="CancelButton"
                    AccessKey="C"
                    AutomationProperties.Name="{Binding CancelButtonAccessibleName}"
                    Command="{Binding CancelCommand}"
                    Icon="Cancel"
                    Label="{Binding CancelButtonText}" />
            </CommandBar>
        </Grid>

        <controls:InfoBar
            Grid.Row="1"
            AutomationProperties.HelpText="{Binding InfoBarMessage}"
            AutomationProperties.LiveSetting="Assertive"
            AutomationProperties.Name="{Binding InfoBarTitle}"
            IsClosable="True"
            IsOpen="{Binding IsInfoBarOpen, Mode=TwoWay}"
            Message="{Binding InfoBarMessage}"
            Severity="{Binding InfoBarSeverity}"
            Title="{Binding InfoBarTitle}" />

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Setup" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Choose where media comes from and where transcripts go."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="6">
                        <TextBox
                            x:Name="InputFolderTextBox"
                            AutomationProperties.HelpText="Choose the folder that contains MP4 files to transcribe."
                            AutomationProperties.Name="Input folder"
                            Header="Input folder"
                            IsReadOnly="True"
                            PlaceholderText="No folder selected"
                            Text="{Binding InputFolderPath, Mode=OneWay}"
                            ToolTipService.ToolTip="{Binding InputFolderPath}" />
                        <Button
                            x:Name="BrowseInputButton"
                            HorizontalAlignment="Stretch"
                            AccessKey="I"
                            AutomationProperties.Name="Browse for input folder"
                            Click="BrowseInputButton_Click"
                            Content="Choose input folder…"
                            IsEnabled="{Binding IsFolderSelectionEnabled}" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                            Text="{Binding InputValidationMessage}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="6">
                        <TextBox
                            x:Name="OutputFolderTextBox"
                            AutomationProperties.HelpText="Choose where matching WebVTT files will be written."
                            AutomationProperties.Name="Output folder"
                            Header="Output folder"
                            IsReadOnly="True"
                            PlaceholderText="No folder selected"
                            Text="{Binding OutputFolderPath, Mode=OneWay}"
                            ToolTipService.ToolTip="{Binding OutputFolderPath}" />
                        <Button
                            x:Name="BrowseOutputButton"
                            HorizontalAlignment="Stretch"
                            AccessKey="O"
                            AutomationProperties.Name="Browse for output folder"
                            Click="BrowseOutputButton_Click"
                            Content="Choose output folder…"
                            IsEnabled="{Binding IsFolderSelectionEnabled}" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                            Text="{Binding OutputValidationMessage}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        Grid.Row="4"
                        Padding="12"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE8B7;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{Binding FoundMp4Text}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="Batch progress" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding BatchCountText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{Binding BatchElapsedText}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding BatchEtaText}" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar
                            Grid.Row="1"
                            Height="6"
                            AutomationProperties.Name="Overall batch progress"
                            Maximum="100"
                            Value="{Binding BatchProgressPercent}" />

                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="36"
                                Height="36"
                                VerticalAlignment="Top"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                CornerRadius="18">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Glyph="&#xE8D6;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{Binding CurrentFileName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding CurrentStageText}"
                                    TextWrapping="Wrap" />
                                <ProgressBar
                                    AutomationProperties.Name="Current file progress"
                                    IsIndeterminate="{Binding IsProgressIndeterminate}"
                                    Maximum="100"
                                    Value="{Binding CurrentFileProgressPercent}" />
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding CurrentFileTimingText}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="20,16,20,12" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Transcription queue" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="One file at a time" />
                        </Grid>

                        <ListView
                            Grid.Row="1"
                            Padding="8,0,8,8"
                            AutomationProperties.Name="Transcription files"
                            IsItemClickEnabled="False"
                            ItemsSource="{Binding Jobs}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,1" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Top"
                                            AutomationProperties.Name="{Binding StatusText}"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="15"
                                            Text="{Binding StatusGlyph}" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock
                                                AutomationProperties.Name="{Binding AccessibleDescription}"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{Binding FileName}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{Binding RelativePath}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Detail}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{Binding Detail}" />
                                            <ProgressBar
                                                Height="3"
                                                AutomationProperties.Name="File progress"
                                                Maximum="100"
                                                Value="{Binding ProgressPercent}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" MinWidth="142" Spacing="3">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Text="{Binding StatusText}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding TimingText}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
