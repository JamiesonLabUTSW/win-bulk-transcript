<UserControl
    x:Class="WinBulkTranscript.App.LegalOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    KeyDown="Overlay_KeyDown"
    Visibility="Collapsed">
    <Grid
        x:Name="OverlayRoot"
        Padding="32"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Border
            MaxWidth="900"
            MaxHeight="680"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid Padding="28,24,28,24" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="HeadingText"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Academic Research Use Acknowledgement"
                    TextWrapping="Wrap" />

                <StackPanel
                    x:Name="AcknowledgementPanel"
                    Grid.Row="1"
                    MaxWidth="720"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Spacing="18">
                    <TextBlock
                        Text="WinBulkTranscript may be used only for academic research. Commercial use is prohibited, and use by any for-profit entity is considered commercial. Third-party components and models remain subject to separate license terms."
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="For further information, review the full license and third-party notices."
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="By selecting Accept and Continue, you acknowledge these terms."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid
                    x:Name="LegalPanel"
                    Grid.Row="1"
                    MinHeight="300"
                    Visibility="Collapsed">
                    <TabView
                        x:Name="LegalTabs"
                        AutomationProperties.Name="Legal documents"
                        IsAddTabButtonVisible="False">
                        <TabViewItem
                            Header="Application License"
                            HorizontalContentAlignment="Stretch"
                            IsClosable="False"
                            VerticalContentAlignment="Stretch">
                            <ScrollViewer
                                x:Name="LicenseScroller"
                                AutomationProperties.Name="Application License scrollable document"
                                HorizontalContentAlignment="Stretch"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    x:Name="LicenseDocument"
                                    Margin="16,12,20,20"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.HelpText="Read-only selectable text. Use the vertical scrollbar to review the complete document."
                                    AutomationProperties.Name="Application License document text"
                                    FontFamily="Consolas"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="WrapWholeWords" />
                            </ScrollViewer>
                        </TabViewItem>
                        <TabViewItem
                            Header="Third-Party Notices"
                            HorizontalContentAlignment="Stretch"
                            IsClosable="False"
                            VerticalContentAlignment="Stretch">
                            <ScrollViewer
                                x:Name="NoticesScroller"
                                AutomationProperties.Name="Third-Party Notices scrollable document"
                                HorizontalContentAlignment="Stretch"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    x:Name="NoticesDocument"
                                    Margin="16,12,20,20"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.HelpText="Read-only selectable text. Use the vertical scrollbar to review the complete document."
                                    AutomationProperties.Name="Third-Party Notices document text"
                                    FontFamily="Consolas"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="WrapWholeWords" />
                            </ScrollViewer>
                        </TabViewItem>
                    </TabView>
                </Grid>

                <Grid
                    x:Name="AcknowledgementActions"
                    Grid.Row="2"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="AcceptButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Accept and Continue"
                        Click="AcceptButton_Click"
                        Content="Accept and Continue">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="#107C10" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0E6F0E" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0B570B" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                        </Button.Resources>
                    </Button>
                    <Button
                        x:Name="ViewLicenseButton"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="View License"
                        Click="ViewLicenseButton_Click"
                        Content="View License" />
                    <Button
                        x:Name="DeclineButton"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Decline and Exit"
                        Click="DeclineButton_Click"
                        Content="Decline and Exit">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="#C42B1C" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#B3261A" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#8F1F17" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                        </Button.Resources>
                    </Button>
                </Grid>

                <Grid
                    x:Name="LegalActions"
                    Grid.Row="2"
                    Visibility="Collapsed">
                    <Button
                        x:Name="BackButton"
                        MinWidth="240"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Back to Acknowledgement"
                        Click="BackButton_Click"
                        Content="Back to Acknowledgement" />
                    <Button
                        x:Name="CloseButton"
                        MinWidth="180"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Close"
                        Click="CloseButton_Click"
                        Content="Close"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
